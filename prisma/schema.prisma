generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  nameBn       String
  category     String
  mark         String
  monthlyPrice Int
  isOneTime    Boolean  @default(false)
  unitLabel    String   @default("")
  badge        String
  deliveryEta  String
  stock        Int      @default(0)
  aboutBn      String
  metaBn       String
  specs        Json     @default("[]")
  includes     Json     @default("[]")
  wasPrice     Int?
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orderItems OrderItem[]
}

model Order {
  id            String      @id @default(cuid())
  orderId       String      @unique // human-readable PH-XXXX
  customerName  String
  phone         String
  email         String
  paymentMethod String
  txnId         String
  subtotal      Int
  discount      Int         @default(0)
  total         Int
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items OrderItem[]
}

enum OrderStatus {
  PENDING
  VERIFIED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  productId  String
  termMonths Int
  qty        Int
  unitPrice  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Message {
  id        String   @id @default(cuid())
  name      String?
  phone     String?
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
